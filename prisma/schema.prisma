generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum Tariff {
  NONE
  START
  GROWTH
  PREMIUM
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

/// Sales-pipeline stages for an inbound lead / deal.
enum DealStage {
  NEW          // Новая заявка
  NEGOTIATION  // Переговоры
  PROPOSAL     // Коммерческое
  WON          // Клиент
  LOST         // Отказ
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// Type of a timeline entry (notes & history).
enum ActivityKind {
  NOTE
  CALL
  MEETING
  EMAIL
  STAGE   // automatic entry when a deal changes stage
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(CLIENT)
  tariff    Tariff   @default(NONE)
  tariffEnd DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client      Client?
  ownedDeals  Deal[]     @relation("DealOwner")
  ownedTasks  Task[]     @relation("TaskOwner")
  activities  Activity[] @relation("ActivityAuthor")
}

model Client {
  id           String       @id @default(cuid())
  ownerId      String       @unique
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName String
  niche        String
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reports      MonthlyReport[]
  deals        Deal[]
  tasks        Task[]
  activities   Activity[]
  payments     Payment[]
}

/// One report per client per calendar month — filled in manually by the agency.
model MonthlyReport {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     Int // 1–12
  year      Int
  spent     Float    @default(0)
  budget    Float    @default(0)
  reach     Int      @default(0)
  clicks    Int      @default(0)
  leads     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platforms Platform[]
  campaigns Campaign[]
  audience  AudienceBreakdown?

  @@unique([clientId, year, month])
  @@index([clientId, year, month])
}

/// Per-platform spend + ROAS inside a monthly report (Instagram / Facebook / …).
model Platform {
  id       String        @id @default(cuid())
  reportId String
  report   MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name     String
  spent    Float         @default(0)
  roas     Float         @default(0)

  @@unique([reportId, name])
}

model Campaign {
  id        String         @id @default(cuid())
  reportId  String
  report    MonthlyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name      String
  platform  String
  status    CampaignStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([reportId])
}

/// Age-bucket split of the audience for a monthly report.
model AudienceBreakdown {
  id        String        @id @default(cuid())
  reportId  String        @unique
  report    MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  age18_24  Int           @default(0)
  age25_34  Int           @default(0)
  age35_44  Int           @default(0)
  age45plus Int           @default(0)
}

/// A lead / deal in the sales pipeline. Inbound landing-form requests land here at stage NEW.
model Deal {
  id          String     @id @default(cuid())
  title       String                 // business / request title
  contactName String
  phone       String?
  email       String?
  message     String?
  source      String     @default("Лендинг")
  stage       DealStage  @default(NEW)
  amount      Float      @default(0)  // expected monthly value (сомони)
  position    Int        @default(0)  // ordering within a stage column
  ownerId     String?
  owner       User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientId    String?                 // linked client once won
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks       Task[]
  activities  Activity[]

  @@index([stage, position])
}

model Task {
  id        String       @id @default(cuid())
  title     String
  done      Boolean      @default(false)
  dueDate   DateTime?
  priority  TaskPriority @default(MEDIUM)
  ownerId   String?
  owner     User?        @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([done, dueDate])
}

/// Timeline entry attached to a client or a deal (notes & history).
model Activity {
  id        String       @id @default(cuid())
  kind      ActivityKind @default(NOTE)
  body      String
  authorId  String?
  author    User?        @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([clientId, createdAt])
  @@index([dealId, createdAt])
}

model Payment {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount    Float
  status    PaymentStatus @default(PENDING)
  month     Int // period month 1–12
  year      Int
  dueDate   DateTime?
  paidAt    DateTime?
  method    String?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId, year, month])
}
