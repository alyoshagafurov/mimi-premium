generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
}

enum Tariff {
  NONE
  START
  GROWTH
  PREMIUM
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
}

enum DealStage {
  NEW
  NEGOTIATION
  PROPOSAL
  WON
  LOST
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ActivityKind {
  NOTE
  CALL
  MEETING
  EMAIL
  STAGE
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum NotificationKind {
  LEAD
  PAYMENT
  TASK
  REPORT
  MESSAGE
  SYSTEM
}

enum CalendarEventKind {
  MEETING
  CALL
  LAUNCH
  DEADLINE
  OTHER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum FileKind {
  IMAGE
  DOCUMENT
  VIDEO
  CREATIVE
  BRANDBOOK
  OTHER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  role      Role     @default(CLIENT)
  tariff    Tariff   @default(NONE)
  tariffEnd DateTime?
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client          Client?
  ownedDeals      Deal[]            @relation("DealOwner")
  ownedTasks      Task[]            @relation("TaskOwner")
  activities      Activity[]        @relation("ActivityAuthor")
  notifications   Notification[]
  sentMessages    Message[]         @relation("MessageSender")
  uploadedFiles   File[]            @relation("FileUploader")
  calendarEvents  CalendarEvent[]   @relation("EventOwner")
  resetTokens     PasswordResetToken[]
}

/// One-time token for password reset, delivered by email.
model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Client {
  id           String       @id @default(cuid())
  ownerId      String       @unique
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName String
  niche        String
  status       ClientStatus @default(ACTIVE)

  // Onboarding brief
  briefDone        Boolean   @default(false)
  briefGoals       String?
  briefTargetAudience String?
  briefBudget      Float?
  briefCompetitors String?
  briefUSP         String?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reports         MonthlyReport[]
  deals           Deal[]
  tasks           Task[]
  activities      Activity[]
  payments        Payment[]
  files           File[]
  invoices        Invoice[]
  facebookAccount FacebookAccount?
  adMetrics       AdMetric[]
  messages        Message[]
  calendarEvents  CalendarEvent[]
}

model MonthlyReport {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  month     Int
  year      Int
  spent     Float    @default(0)
  budget    Float    @default(0)
  reach     Int      @default(0)
  clicks    Int      @default(0)
  leads     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  platforms Platform[]
  campaigns Campaign[]
  audience  AudienceBreakdown?

  @@unique([clientId, year, month])
  @@index([clientId, year, month])
}

model Platform {
  id       String        @id @default(cuid())
  reportId String
  report   MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name     String
  spent    Float         @default(0)
  roas     Float         @default(0)

  @@unique([reportId, name])
}

model Campaign {
  id        String         @id @default(cuid())
  reportId  String
  report    MonthlyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name      String
  platform  String
  status    CampaignStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([reportId])
}

model AudienceBreakdown {
  id        String        @id @default(cuid())
  reportId  String        @unique
  report    MonthlyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  age18_24  Int           @default(0)
  age25_34  Int           @default(0)
  age35_44  Int           @default(0)
  age45plus Int           @default(0)
}

model Deal {
  id          String     @id @default(cuid())
  title       String
  contactName String
  phone       String?
  email       String?
  message     String?
  source      String     @default("Лендинг")
  stage       DealStage  @default(NEW)
  amount      Float      @default(0)
  position    Int        @default(0)
  ownerId     String?
  owner       User?      @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks       Task[]
  activities  Activity[]

  @@index([stage, position])
}

model Task {
  id        String       @id @default(cuid())
  title     String
  done      Boolean      @default(false)
  dueDate   DateTime?
  priority  TaskPriority @default(MEDIUM)
  ownerId   String?
  owner     User?        @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([done, dueDate])
}

model Activity {
  id        String       @id @default(cuid())
  kind      ActivityKind @default(NOTE)
  body      String
  authorId  String?
  author    User?        @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([clientId, createdAt])
  @@index([dealId, createdAt])
}

model Payment {
  id        String        @id @default(cuid())
  clientId  String
  client    Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount    Float
  status    PaymentStatus @default(PENDING)
  month     Int
  year      Int
  dueDate   DateTime?
  paidAt    DateTime?
  method    String?
  note      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([clientId, year, month])
}

/// In-app notifications shown via bell icon in topbar.
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind @default(SYSTEM)
  title     String
  body      String?
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

/// Chat messages between admin and client.
model Message {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

/// File storage — creatives, brandbook, documents per client.
model File {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploaderId  String?
  uploader    User?    @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: SetNull)
  name        String
  url         String
  size        Int      @default(0)
  mime        String?
  kind        FileKind @default(OTHER)
  createdAt   DateTime @default(now())

  @@index([clientId, createdAt])
}

/// Calendar events — meetings, launches, deadlines.
model CalendarEvent {
  id          String            @id @default(cuid())
  title       String
  description String?
  kind        CalendarEventKind @default(MEETING)
  startAt     DateTime
  endAt       DateTime?
  clientId    String?
  client      Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerId     String?
  owner       User?             @relation("EventOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startAt])
}

/// Task template — a checklist of tasks applied to a client (e.g. "New PRO client" → 12 tasks).
model TaskTemplate {
  id        String                @id @default(cuid())
  name      String
  description String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  items     TaskTemplateItem[]
}

model TaskTemplateItem {
  id          String       @id @default(cuid())
  templateId  String
  template    TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  title       String
  offsetDays  Int          @default(0)
  priority    TaskPriority @default(MEDIUM)
  position    Int          @default(0)

  @@index([templateId, position])
}

/// Invoices — generated for clients, can be downloaded as PDF.
model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number      String        @unique
  amount      Float
  status      InvoiceStatus @default(DRAFT)
  description String?
  issuedAt    DateTime      @default(now())
  dueDate     DateTime?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([clientId, status])
}

/// Facebook ad account linked to a client — for automatic lead/metric pulls.
model FacebookAccount {
  id            String   @id @default(cuid())
  clientId      String   @unique
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  pageId        String?
  pageName      String?
  adAccountId   String?
  accessToken   String?
  connectedAt   DateTime?
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Daily ad metrics pulled from Facebook (live dashboard data).
model AdMetric {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date        DateTime
  platform    String   @default("Facebook")
  spent       Float    @default(0)
  reach       Int      @default(0)
  clicks      Int      @default(0)
  impressions Int      @default(0)
  leads       Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([clientId, date, platform])
  @@index([clientId, date])
}

// ─────────────────────────────────────────────────────────────
// CMS — public-facing content managed from the admin panel
// ─────────────────────────────────────────────────────────────

/// Portfolio case study (public /cases/[slug]).
model Case {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  clientName     String
  description    String              // short summary / excerpt
  task           String   @default("")
  solution       String   @default("")
  result         String   @default("")
  achievements   String[]            // list of wins
  coverImage     String?
  images         String[]
  date           DateTime @default(now())
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  published      Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, date])
  @@index([category])
}

/// Client testimonial (published on landing / about).
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  company   String?
  position  String?
  photo     String?
  rating    Int      @default(5)
  text      String
  date      DateTime @default(now())
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// Blog post (public /blog/[slug]).
model BlogPost {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  category       String
  cover          String?
  excerpt        String?
  content        String   @default("")   // Markdown
  author         String   @default("mimi")
  date           DateTime @default(now())
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  published      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, date])
  @@index([category])
}

/// Team member.
model TeamMember {
  id        String   @id @default(cuid())
  name      String
  position  String
  photo     String?
  bio       String?
  socials   Json?              // { instagram, telegram, linkedin, website }
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// Client logo (brands we worked with).
model ClientLogo {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  url       String?
  category  String?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// FAQ entry (DB-managed).
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// Company statistic / achievement counter.
model CompanyStat {
  id        String   @id @default(cuid())
  label     String
  value     String            // "150+", "4.8", "20M" — kept as string for formatting
  suffix    String?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// Partner brand.
model Partner {
  id        String   @id @default(cuid())
  name      String
  logo      String?
  url       String?
  published Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

/// Certificate.
model Certificate {
  id        String    @id @default(cuid())
  title     String
  image     String?
  issuer    String?
  date      DateTime?
  published Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([published, sortOrder])
}

/// Award / recognition.
model Award {
  id        String    @id @default(cuid())
  title     String
  image     String?
  issuer    String?
  date      DateTime?
  published Boolean   @default(true)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([published, sortOrder])
}
