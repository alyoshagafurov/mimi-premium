# ─────────────────────────────────────────────────────────────
# mimi — environment variables
# Copy to .env (local) and set the same keys in Vercel → Settings → Env Vars.
# The app RUNS without the optional keys; each feature turns on when its key is set.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ──────────────────────────────────────────────────
# PostgreSQL (Neon). Use the pooled connection string on Vercel.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Auth. Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-generate-with-openssl-rand-base64-32"
# Public URL of the deployment (production domain). Used for canonical URLs,
# sitemap, robots, Open Graph and structured data — keep it exact (no trailing slash).
NEXTAUTH_URL="https://mimitj.agency"
NEXT_PUBLIC_APP_URL="https://mimitj.agency"

# SEO — Google Search Console verification code (the content= value of the meta tag).
GOOGLE_SITE_VERIFICATION=""

# ── BRAND (public, shown on the site) ─────────────────────────
NEXT_PUBLIC_BRAND_PHONE="+992 07 021 77 55"
NEXT_PUBLIC_BRAND_INSTAGRAM="https://instagram.com/mimi.agency.tj"
NEXT_PUBLIC_BRAND_WEB="mimi.agency.tj.com"
NEXT_PUBLIC_BRAND_EMAIL="hello@mimi.agency.tj"

# ── EMAIL (optional — Resend). Without it, emails are skipped. ─
RESEND_API_KEY=""
EMAIL_FROM="mimi <hello@your-verified-domain>"

# ── FACEBOOK / INSTAGRAM (optional) ───────────────────────────
# App-level (for reference / future OAuth):
FB_APP_ID=""
FB_APP_SECRET=""
# Any random string you choose; must match the value set in the FB webhook config.
FB_VERIFY_TOKEN=""
# Per-client Page Access Token + Ad Account ID are entered in Admin → Integrations.

# ── FILE STORAGE (optional — Vercel Blob). Falls back to DB base64. ─
BLOB_READ_WRITE_TOKEN=""

# ── RATE LIMITING (optional — Upstash Redis). Falls back to in-memory. ─
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── MONITORING (optional — Sentry). Without it, errors log to Vercel only. ─
SENTRY_DSN=""

# ── CRON (optional — protects the daily Facebook metrics sync) ─
# Vercel Cron sends: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# ── SEED (optional — overrides default admin@mimi.agency / mimi2024) ─
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
